# LocalStack container settings (consumed by compose.yaml)
LOCALSTACK_DOCKER_NAME=localstack-main
DEBUG=0
PERSISTENCE=0
LOCALSTACK_VOLUME_DIR=./volume

# Required ONLY if you switch the image to `latest` (2026.x):
# create a free account at https://app.localstack.cloud and paste your token
LOCALSTACK_AUTH_TOKEN=

# Client-side default region (used by scripts / your future SDK code)
AWS_DEFAULT_REGION=eu-west-1
